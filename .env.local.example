# =============================================================================
# MiTea Online Ordering — Production & Staging Environment Configuration
# Copy this file to .env.local for local development.
# In production (Vercel, AWS, Cloudflare, etc.), configure these in project settings.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION URL (CRITICAL FOR REDIRECTS & WEBHOOKS)
# -----------------------------------------------------------------------------
# Development: http://localhost:3000
# Production: https://yourdomain.com (e.g., https://mitea.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. SUPABASE (Database, Row-Level Security, Auth, Storage)
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_SECRET_KEY=your-service-role-secret-key

# -----------------------------------------------------------------------------
# 3. STRIPE (Credit Cards, Apple Pay, Google Pay, Webhooks)
# -----------------------------------------------------------------------------
# Test Mode: starts with sk_test_ / pk_test_
# Production Mode: MUST start with sk_live_ / pk_live_
# Webhook: Obtain from Stripe Dashboard -> Developers -> Webhooks
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# 4. MASTER ADMINISTRATOR PORTAL (/admin)
# -----------------------------------------------------------------------------
# Use a strong, unique password and a high-entropy secret (e.g. openssl rand -hex 32)
ADMIN_EMAIL=admin@mitea.com
ADMIN_PASSWORD=change-me-to-a-strong-random-password-32-chars
ADMIN_SESSION_SECRET=generate-random-secret-key-for-admin-sessions-min-32-chars
# Optional dedicated server-to-server API key (leave unset or randomized)
ADMIN_KEY=

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Order Confirmations & Notifications)
# -----------------------------------------------------------------------------
# Option A: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orders@mitea.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="MiTea Orders <orders@mitea.com>"

# Option B: Resend (Alternative to SMTP)
# RESEND_API_KEY=re_...
# EMAIL_FROM="MiTea <orders@mitea.com>"

# -----------------------------------------------------------------------------
# 6. UPSTASH REDIS (Rate Limiting & Anti-Brute-Force)
# -----------------------------------------------------------------------------
# Found in: Upstash Console -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
